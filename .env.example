# OPENROUTER_API_KEY: Required for OpenRouter AI API calls.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# FEISHU_WEBHOOK: Feishu (Lark) bot webhook URL for access notifications.
FEISHU_WEBHOOK="YOUR_FEISHU_WEBHOOK_URL"

# APP_SERVER_IP: Production server IP (used for health-check whitelist).
APP_SERVER_IP="YOUR_SERVER_IP"

# APP_SERVER_URL: Full URL of the production server.
APP_SERVER_URL="http://YOUR_SERVER_IP:8009"
